package main

import "fmt"
import "strconv"
import ui "github.com/MXLange/go-templ-components"
import "github.com/MXLange/go-templ-components/assets"

var sections = []struct{ ID, Label string }{
	{"dashboard", "Dashboard"}, {"buttons", "Button"}, {"forms", "Input · Textarea · Checkbox · Select"},
	{"surfaces", "Card · Badge · Alert"}, {"overlays", "Dialog · Dropdown"}, {"tabs", "Tabs"},
	{"table", "Table · Pagination"}, {"partial-table", "Atualização parcial · Link"}, {"navigation", "Sidebar · Breadcrumb"}, {"toast", "Toast"}, {"localization", "Idiomas"}, {"dynamic", "JavaScript dinâmico"}, {"customization", "CSS personalizado"},
}

const customizationCSS = `.checkout-submit {
  background: #14532d;
  color: #fff;
  border-radius: 0;
  padding-inline: 2rem;
}
.checkout-submit:hover { background: #166534; }

.catalog-custom-theme {
  --gtc-color-primary: #6b21a8;
  --gtc-color-primary-text: #fff;
}`

templ codeExample(code string) {
	<details class="catalog-code">
		<summary>Ver código</summary>
		<pre><code>{ code }</code></pre>
	</details>
}

templ catalog(data catalogData) {
	<!DOCTYPE html>
	<html lang="pt-BR" data-gtc-density="comfortable">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Catálogo de componentes Go + Templ com temas, densidades e CSS personalizável."/>
			<title>go-templ-components · Catálogo</title>
			@assets.Include("/assets")
			<link rel="stylesheet" href="/static/catalog.css"/>
			<script src="/static/catalog.js" defer></script>
		</head>
		<body>
			<a class="catalog-skip" href="#content">Ir para o conteúdo</a>
			<header class="catalog-header">
				<a href="/" class="catalog-brand"><span class="catalog-brand-mark" aria-hidden="true">t.</span> go-templ-components</a>
				<div class="catalog-toolbar">
					<label>Tema <select id="theme-control"><option value="system">Sistema</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
					<label>Densidade <select id="density-control"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></label>
				</div>
			</header>
			@ui.Toast(ui.ToastProps{BaseProps: ui.BaseProps{ID: "catalog-toasts"}})
			<div class="catalog-layout">
				<div class="catalog-navigation">
					@ui.SidebarToggle(ui.SidebarToggleProps{ButtonProps: ui.ButtonProps{BaseProps: ui.BaseProps{ID: "catalog-nav-toggle"}, Variant: ui.ButtonSecondary}, Target: "catalog-sidebar"}) {
						Componentes 
					}
					@ui.Sidebar(ui.SidebarProps{BaseProps: ui.BaseProps{ID: "catalog-sidebar"}, Label: "Componentes do catálogo", MobileModal: true}) {
						<nav aria-label="Seções do catálogo">
							<p class="catalog-nav-title">COMPONENTES</p>
							for _, section := range sections {
								<a href={ templ.URL("#" + section.ID) }>{ section.Label }</a>
							}
						</nav>
						<p class="catalog-version">v0.1.0 · Go + Templ</p>
					}
				</div>
				<main id="content" class="catalog-main">
					<div class="catalog-intro">
						@ui.Breadcrumb(ui.BreadcrumbProps{Items: []ui.NavItem{{Label: "Biblioteca", Href: "/"}, {Label: "Catálogo", Current: true}}})
						<h1>Componentes para construir.</h1>
						<p>HTML no servidor. Interações no navegador. O CSS é seu.</p>
					</div>
					<section id="dashboard" class="catalog-section" aria-labelledby="dashboard-title">
						<div class="catalog-section-heading">
							<h2 id="dashboard-title">Dashboard</h2>@ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) {
	Operacional 
}
						</div>
						<div class="catalog-dashboard">
							<div class="catalog-dashboard-summary"><span>PROJETOS ATIVOS</span><strong>24</strong><p>18 em produção · 6 em desenvolvimento</p></div>
							<div class="catalog-dashboard-activity">
								<h3>Última atividade</h3>
								<p><strong>Portal do cliente</strong> recebeu uma atualização.</p>
								<p class="catalog-muted">Todos os serviços estão disponíveis.</p>@ui.Badge(ui.BadgeProps{Tone: ui.ToneNeutral}) {
	Atualizado agora 
}
							</div>
						</div>
					</section>
					<section id="buttons" class="catalog-section" aria-labelledby="buttons-title">
						<h2 id="buttons-title">Button</h2>
						<p class="catalog-description">Hierarquia, tamanhos e estados de interação.</p>
						<div class="catalog-example catalog-stack">
							<div class="catalog-row">
								@ui.Button(ui.ButtonProps{}) {
									Criar projeto 
								}
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary}) {
									Exportar 
								}
								@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}) {
									Cancelar 
								}
								@ui.Button(ui.ButtonProps{Disabled: true}) {
									Indisponível 
								}
								@ui.Button(ui.ButtonProps{Loading: true}) {
									Salvando 
								}
							</div>
							<div class="catalog-row">
								@ui.Button(ui.ButtonProps{Size: ui.SizeSmall, Variant: ui.ButtonSecondary}) {
									Small 
								}
								@ui.Button(ui.ButtonProps{Size: ui.SizeMedium, Variant: ui.ButtonSecondary}) {
									Medium 
								}
								@ui.Button(ui.ButtonProps{Size: ui.SizeLarge, Variant: ui.ButtonSecondary}) {
									Large 
								}
							</div>
						</div>
						@codeExample("@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}) {\n    Criar projeto\n}")
					</section>
					<section id="forms" class="catalog-section" aria-labelledby="forms-title">
						<h2 id="forms-title">Formulários</h2>
						<p class="catalog-description">Controles nativos com rótulos, ajuda e mensagens de erro.</p>
						<form class="catalog-example catalog-stack" method="post" action="/demo/form#forms">
							if data.Success {
								@ui.Alert(ui.AlertProps{Tone: ui.ToneSuccess, Title: "Formulário recebido"}) {
									Demonstração concluída. Os dados não foram armazenados. 
								}
							}
							<div class="catalog-grid">
								@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{BaseProps: ui.BaseProps{ID: "project-name"}, Label: "Nome do projeto", Name: "name", Description: "Use um nome que identifique o projeto.", Error: data.Error, Required: true}, Value: data.Name, Placeholder: "Portal do cliente"})
								@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Label: "E-mail", Name: "email"}, Type: "email", Value: data.Email, Autocomplete: "email", Placeholder: "equipe@exemplo.com"})
								@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{Label: "Ambiente", Name: "environment"}, Value: "dev", Options: []ui.SelectOption{{Value: "dev", Label: "Desenvolvimento"}, {Value: "prod", Label: "Produção"}, {Value: "legacy", Label: "Legado", Disabled: true}}})
								@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Label: "Identificador", Disabled: true}, Value: "PRJ-0024"})
							</div>
							@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{Label: "Descrição", Name: "description"}, Placeholder: "Descreva o objetivo do projeto.", Rows: 3})
							@ui.Checkbox(ui.CheckboxProps{FieldProps: ui.FieldProps{Label: "Receber notificações do projeto", Name: "notifications"}, Checked: true})
							<div>
								@ui.Button(ui.ButtonProps{Type: "submit"}) {
									Enviar formulário 
								}
							</div>
						</form>
						<div class="catalog-example catalog-space-top">
							@ui.Input(ui.InputProps{
								FieldProps: ui.FieldProps{
									BaseProps: ui.BaseProps{ID: "validation-email", Attributes: templ.Attributes{"data-demo-email": ""}},
									Label:     "Exemplo de erro", Description: "Digite um e-mail válido para atualizar o estado do campo.",
									Error: "Informe um endereço de e-mail válido.", Required: true,
								},
								Type: "email", Value: "email-inválido", Autocomplete: "email",
							})
						</div>
						@codeExample("@ui.Input(ui.InputProps{\n    FieldProps: ui.FieldProps{Label: \"Nome\", Name: \"name\", Required: true},\n    Placeholder: \"Nome do projeto\",\n})\n@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{Label: \"Descrição\"}})\n@ui.Checkbox(ui.CheckboxProps{FieldProps: ui.FieldProps{Label: \"Ativo\"}})\n@ui.Select(ui.SelectProps{\n    FieldProps: ui.FieldProps{Label: \"Ambiente\"},\n    Options: []ui.SelectOption{{Value: \"dev\", Label: \"Desenvolvimento\"}},\n})")
					</section>
					<section id="surfaces" class="catalog-section" aria-labelledby="surfaces-title">
						<h2 id="surfaces-title">Card, Badge e Alert</h2>
						<div class="catalog-grid">
							@ui.Card(ui.CardProps{Title: "Plano da equipe", Description: "Recursos disponíveis para este projeto."}) {
								<p>12 membros · 24 projetos · backups diários</p>
								<div class="catalog-row">
									@ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) {
										Ativo 
									} @ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Size: ui.SizeSmall}) {
	Gerenciar 
}
								</div>
							}
							<div class="catalog-stack">
								<div class="catalog-row">
									@ui.Badge(ui.BadgeProps{}) {
										Rascunho 
									} @ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) {
	Publicado 
} @ui.Badge(ui.BadgeProps{Tone: ui.ToneWarning}) {
	Pendente 
} @ui.Badge(ui.BadgeProps{Tone: ui.ToneError}) {
	Falha 
}
								</div>
								@ui.Alert(ui.AlertProps{Tone: ui.ToneWarning, Title: "Manutenção programada"}) {
									O serviço ficará indisponível das 02h às 03h. 
								}
							</div>
						</div>
						<div class="catalog-grid catalog-space-top">
							@ui.Alert(ui.AlertProps{Title: "Informação"}) {
								A configuração será aplicada no próximo acesso. 
							}
							@ui.Alert(ui.AlertProps{Tone: ui.ToneSuccess, Title: "Concluído"}) {
								As alterações foram salvas. 
							}
							@ui.Alert(ui.AlertProps{Tone: ui.ToneError, Title: "Falha ao conectar"}) {
								Verifique a conexão e tente novamente. 
							}
						</div>
						@codeExample("@ui.Card(ui.CardProps{Title: \"Projeto\"}) { Conteúdo }\n@ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) { Ativo }\n@ui.Alert(ui.AlertProps{Tone: ui.ToneWarning, Title: \"Atenção\"}) { Mensagem }")
					</section>
					<section id="overlays" class="catalog-section" aria-labelledby="overlays-title">
						<h2 id="overlays-title">Dialog e Dropdown</h2>
						<p class="catalog-description">Use Tab, setas e Escape para navegar pelo teclado.</p>
						<div class="catalog-example catalog-row">
							@ui.DialogTrigger(ui.DialogTriggerProps{Target: "project-dialog"}) {
								Abrir diálogo 
							}
							@ui.Dropdown(ui.DropdownProps{BaseProps: ui.BaseProps{ID: "project-actions"}, Label: "Ações do projeto"}) {
								@ui.DropdownItem(ui.DropdownItemProps{Value: "edit", Href: "#forms"}) {
									Editar projeto 
								}
								@ui.DropdownItem(ui.DropdownItemProps{Value: "duplicate"}) {
									Duplicar projeto 
								}
								@ui.DropdownItem(ui.DropdownItemProps{Value: "archive", Disabled: true}) {
									Arquivar projeto 
								}
							}
							<p id="dropdown-result" class="catalog-muted" role="status">Selecione uma ação.</p>
						</div>
						@ui.Dialog(ui.DialogProps{BaseProps: ui.BaseProps{ID: "project-dialog"}, Title: "Detalhes do projeto"}) {
							<div class="catalog-stack">
								<p>Este diálogo usa o elemento HTML nativo. O foco permanece dentro dele durante a interação.</p>@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Label: "Responsável"}, Placeholder: "Nome da pessoa"})
								<div>
									@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{Attributes: templ.Attributes{"data-gtc-dialog-close": ""}}, Variant: ui.ButtonSecondary}) {
										Concluir 
									}
								</div>
							</div>
						}
						@codeExample("@ui.DialogTrigger(ui.DialogTriggerProps{Target: \"details\"}) { Abrir }\n@ui.Dialog(ui.DialogProps{BaseProps: ui.BaseProps{ID: \"details\"}, Title: \"Detalhes\"}) {\n    Conteúdo do diálogo\n}\n@ui.Dropdown(ui.DropdownProps{Label: \"Ações\"}) {\n    @ui.DropdownItem(ui.DropdownItemProps{Value: \"edit\"}) { Editar }\n}")
					</section>
					<section id="tabs" class="catalog-section" aria-labelledby="tabs-title">
						<h2 id="tabs-title">Tabs</h2>
						<div class="catalog-example">
							@ui.Tabs(ui.TabsProps{BaseProps: ui.BaseProps{ID: "project-tabs"}, Label: "Informações do projeto", Items: []ui.TabItem{{Label: "Visão geral", Content: overviewPanel()}, {Label: "Atividade", Content: activityPanel()}, {Label: "Permissões", Disabled: true}}})
						</div>
						@codeExample("@ui.Tabs(ui.TabsProps{\n    Label: \"Projeto\",\n    Items: []ui.TabItem{\n        {Label: \"Resumo\", Content: summary()},\n        {Label: \"Atividade\", Content: activity()},\n    },\n})")
					</section>
					<section id="table" class="catalog-section" aria-labelledby="table-title">
						<h2 id="table-title">Table e Pagination</h2>
						<p class="catalog-description">A URL controla a página. O servidor seleciona os registros.</p>
						<div class="catalog-example catalog-stack">
							@projectTable(data.Page, 3)
							@ui.Pagination(projectPagination(data.Page))
						</div>
						<details class="catalog-states">
							<summary>Estados da tabela</summary>
							<div class="catalog-stack catalog-space-top">
								@ui.Table(ui.TableProps{Caption: "Nenhum projeto encontrado"}) {
									<tbody><tr><td class="gtc-table-cell">Crie um projeto para começar.</td></tr></tbody>
								}
								@ui.Table(ui.TableProps{Caption: "Carregando projetos", Loading: true}) {
									<tbody><tr><td class="gtc-table-cell">Aguarde o carregamento.</td></tr></tbody>
								}
								@ui.Alert(ui.AlertProps{Tone: ui.ToneError, Title: "Falha ao carregar projetos"}) {
									Tente novamente. 
								}
							</div>
						</details>
						@codeExample("@ui.Table(ui.TableProps{Caption: \"Projetos\"}) {\n    @ui.TableHead(ui.BaseProps{}) {\n        @ui.TableRow(ui.BaseProps{}) {\n            @ui.TableHeader(ui.TableCellProps{}) { Nome }\n        }\n    }\n    @ui.TableBody(ui.BaseProps{}) {\n        @ui.TableRow(ui.BaseProps{}) {\n            @ui.TableCell(ui.TableCellProps{}) { Portal }\n        }\n    }\n}\n@ui.Pagination(ui.PaginationProps{Items: []ui.NavItem{\n    {Label: \"1\", Href: \"?page=1\", Current: true},\n}})")
					</section>
					<section id="partial-table" class="catalog-section" aria-labelledby="partial-table-title">
						<h2 id="partial-table-title">Atualização parcial</h2>
						<p class="catalog-description">O servidor renderiza somente esta região. A URL e o histórico acompanham a página selecionada.</p>
						<div id="partial-projects" class="catalog-example" role="region" aria-label="Projetos com atualização parcial">
							@partialProjects(data.PartialPage, data.Page)
						</div>
						@codeExample("<div id=\"projetos\">\n    @projectTable(page)\n    @ui.Pagination(ui.PaginationProps{\n        Items: pages,\n        Partial: &ui.PartialProps{TargetID: \"projetos\", History: true},\n    })\n</div>\n\n@ui.Link(ui.LinkProps{\n    Href: \"/?page=4\",\n    Partial: &ui.PartialProps{TargetID: \"projetos\", History: true},\n}) { Abrir página 4 }")
					</section>
					<section id="navigation" class="catalog-section" aria-labelledby="navigation-title">
						<h2 id="navigation-title">Sidebar e Breadcrumb</h2>
						<p class="catalog-description">A navegação lateral do catálogo também usa Sidebar.</p>
						<div class="catalog-example catalog-stack">
							@ui.Breadcrumb(ui.BreadcrumbProps{Label: "Exemplo de caminho", Items: []ui.NavItem{{Label: "Início", Href: "#dashboard"}, {Label: "Projetos", Href: "#table"}, {Label: "Portal do cliente", Current: true}}})
							<div>
								@ui.SidebarToggle(ui.SidebarToggleProps{Target: "demo-sidebar", ButtonProps: ui.ButtonProps{Variant: ui.ButtonSecondary}}) {
									Alternar navegação 
								}
							</div>
							@ui.Sidebar(ui.SidebarProps{BaseProps: ui.BaseProps{ID: "demo-sidebar"}, Label: "Navegação de exemplo"}) {
								<nav class="catalog-demo-nav" aria-label="Projeto"><a href="#dashboard">Visão geral</a><a href="#forms">Configurações</a><a href="#table">Projetos</a></nav>
							}
						</div>
						@codeExample("@ui.SidebarToggle(ui.SidebarToggleProps{Target: \"navigation\"}) { Menu }\n@ui.Sidebar(ui.SidebarProps{BaseProps: ui.BaseProps{ID: \"navigation\"}}) {\n    <nav aria-label=\"Principal\"><a href=\"/\">Início</a></nav>\n}\n@ui.Breadcrumb(ui.BreadcrumbProps{Items: []ui.NavItem{\n    {Label: \"Início\", Href: \"/\"}, {Label: \"Projetos\", Current: true},\n}})")
					</section>
					<section id="toast" class="catalog-section" aria-labelledby="toast-title">
						<h2 id="toast-title">Toast</h2>
						<p class="catalog-description">Notificações anunciadas por uma região acessível. Dispensa manual por padrão.</p>
						<div class="catalog-example catalog-row">
							@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{Attributes: templ.Attributes{"data-demo-toast": "success"}}}) {
								Notificar sucesso 
							}
							@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{Attributes: templ.Attributes{"data-demo-toast": "error"}}, Variant: ui.ButtonSecondary}) {
								Notificar erro 
							}
						</div>
						@codeExample("// No layout Templ:\n@ui.Toast(ui.ToastProps{})\n\n// No JavaScript do projeto:\nconst id = GTC.toast(\"Alterações salvas.\", { tone: \"success\" });\n// GTC.dismissToast(id);")
					</section>
					<section id="localization" class="catalog-section" aria-labelledby="localization-title">
						<h2 id="localization-title">Idiomas</h2>
						<p class="catalog-description">As mensagens da biblioteca seguem o contexto. Cada instância também pode substituir textos específicos.</p>
						<div class="catalog-grid">
							@localizedComponents("pt-BR")
							@localizedComponents("en")
						</div>
						@codeExample("ctx := ui.WithMessages(r.Context(), ui.EnglishMessages())\ntempl.Handler(page()).ServeHTTP(w, r.WithContext(ctx))\n\n// Override por instância:\n@ui.Pagination(ui.PaginationProps{\n    BaseProps: ui.BaseProps{Messages: &ui.Messages{PaginationNext: \"Continue\"}},\n    Items: pages,\n})")
					</section>
					<section id="dynamic" class="catalog-section" aria-labelledby="dynamic-title">
						<h2 id="dynamic-title">JavaScript dinâmico</h2>
						<p class="catalog-description">Insira um componente, alterne as abas e remova o exemplo. Os eventos usam um listener delegado no documento.</p>
						<div class="catalog-example catalog-stack">
							<div class="catalog-row">
								@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{ID: "dynamic-add"}}) {
									Inserir componente 
								}
								@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{ID: "dynamic-init"}, Variant: ui.ButtonSecondary}) {
									Executar GTC.init 
								}
								@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{ID: "dynamic-remove"}, Variant: ui.ButtonGhost}) {
									Remover componente 
								}
							</div>
							<div id="dynamic-host"></div>
							<p id="dynamic-events" role="status" data-event-count="0">Nenhum evento recebido.</p>
						</div>
						<template id="dynamic-component-template">
							@ui.Tabs(ui.TabsProps{BaseProps: ui.BaseProps{ID: "dynamic-example-tabs"}, Label: "Abas dinâmicas", Items: []ui.TabItem{{Label: "Resumo", Content: dynamicText("Conteúdo inserido pelo JavaScript.")}, {Label: "Detalhes", Content: dynamicText("A inicialização automática ativou esta aba.")}}})
						</template>
						@codeExample("host.replaceChildren(template.content.cloneNode(true));\n// O runtime inicializa os componentes automaticamente.\nGTC.init(host); // Opcional e idempotente.\n\ndocument.addEventListener(\"gtc:tabs-change\", event => {\n    if (host.contains(event.target)) {\n        console.log(event.detail.index);\n    }\n});\n\nhost.replaceChildren();")
					</section>
					<section id="customization" class="catalog-section" aria-labelledby="customization-title">
						<h2 id="customization-title">O CSS é seu</h2>
						<p class="catalog-description">Edite o CSS abaixo para testar os estilos no navegador.</p>
						<div class="catalog-example catalog-row">
							@ui.Button(ui.ButtonProps{}) {
								Estilo nativo 
							}
							@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{Class: "checkout-submit"}}) {
								Estilo do projeto 
							}
							<div class="catalog-custom-theme">
								@ui.Button(ui.ButtonProps{}) {
									Token personalizado 
								}
							</div>
						</div>
						<div class="catalog-editor-toolbar">
							<label class="gtc-label" for="css-editor">CSS personalizado</label>
							@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{ID: "css-reset"}, Variant: ui.ButtonSecondary, Size: ui.SizeSmall}) {
								Restaurar CSS
							}
						</div>
						<p class="catalog-muted catalog-editor-help" id="css-editor-help">As alterações são aplicadas ao catálogo enquanto você digita.</p>
						<textarea id="css-editor" class="catalog-css-example" rows="14" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="css-editor-help">{ customizationCSS }</textarea>
					</section>
					<footer class="catalog-footer">Go + Templ · CSS custom properties · JavaScript nativo</footer>
				</main>
			</div>
		</body>
	</html>
}

templ dynamicText(text string) {
	<p>{ text }</p>
}

templ localizedComponents(language string) {
	{{ messages := ui.PTBRMessages() }}
	{{
		if language == "en" {
			messages = ui.EnglishMessages()
		}
	}}
	{{ ctx = ui.WithMessages(ctx, messages) }}
	<div class="catalog-example catalog-stack" id={ "locale-" + language } lang={ language }>
		<h3>{ language }</h3>
		<div class="catalog-row">
			@ui.DialogTrigger(ui.DialogTriggerProps{Target: "locale-dialog-" + language}) {
				{ map[bool]string{true: "Open dialog", false: "Abrir diálogo"}[language == "en"] }
			}
			@ui.Button(ui.ButtonProps{BaseProps: ui.BaseProps{Attributes: templ.Attributes{"data-locale-toast": "locale-toast-" + language}}, Variant: ui.ButtonSecondary}) {
				{ map[bool]string{true: "Show notification", false: "Mostrar notificação"}[language == "en"] }
			}
		</div>
		@ui.Dialog(ui.DialogProps{BaseProps: ui.BaseProps{ID: "locale-dialog-" + language}, Title: map[bool]string{true: "Localized dialog", false: "Diálogo traduzido"}[language == "en"]}) {
			<p>{ map[bool]string{true: "The close button uses the context messages.", false: "O botão de fechamento usa as mensagens do contexto."}[language == "en"] }</p>
		}
		<div id={ "locale-" + language + "-result" } role="region" aria-label={ map[bool]string{true: "English example", false: "Exemplo em português"}[language == "en"] }>
			@localizedResult(language, 1)
		</div>
		@ui.Toast(ui.ToastProps{BaseProps: ui.BaseProps{ID: "locale-toast-" + language}, Label: map[bool]string{true: "Example notifications", false: "Notificações do exemplo"}[language == "en"]})
	</div>
}

templ localizedResult(language string, page int) {
	{{ messages := ui.PTBRMessages() }}
	{{
		if language == "en" {
			messages = ui.EnglishMessages()
		}
	}}
	{{ ctx = ui.WithMessages(ctx, messages) }}
	<div class="catalog-stack" lang={ language }>
		<p>{ fmt.Sprintf(map[bool]string{true: "Page %d", false: "Página %d"}[language == "en"], page) }</p>
		@ui.Pagination(ui.PaginationProps{
			Label:   map[bool]string{true: "English pagination", false: "Paginação em português"}[language == "en"],
			Items:   []ui.NavItem{{Label: "1", Href: "/demo/locale?lang=" + language + "&page=1", Current: page == 1}, {Label: "2", Href: "/demo/locale?lang=" + language + "&page=2", Current: page == 2}},
			Partial: &ui.PartialProps{TargetID: "locale-" + language + "-result"},
		})
		@ui.Tabs(ui.TabsProps{BaseProps: ui.BaseProps{ID: "locale-tabs-" + language}, Items: []ui.TabItem{
			{Label: map[bool]string{true: "Overview", false: "Resumo"}[language == "en"], Content: dynamicText(map[bool]string{true: "Overview content.", false: "Conteúdo do resumo."}[language == "en"])},
			{Label: map[bool]string{true: "Details", false: "Detalhes"}[language == "en"], Content: dynamicText(map[bool]string{true: "Details content.", false: "Conteúdo dos detalhes."}[language == "en"])},
		}})
	</div>
}

templ localizedPage(language string, page int) {
	<!DOCTYPE html>
	<html lang={ language }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>go-templ-components · { language }</title>
			@assets.Include("/assets")
			<link rel="stylesheet" href="/static/catalog.css"/>
		</head>
		<body><main class="catalog-main"><h1>{ language }</h1><div id={ "locale-" + language + "-result" } role="region" aria-label={ language }>@localizedResult(language, page)</div></main></body>
	</html>
}

templ overviewPanel() {
	<div class="catalog-stack">
		<p>O Portal do cliente centraliza os serviços da equipe.</p>
		<div class="catalog-row">
			@ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) {
				Em produção 
			}<span class="catalog-muted">Responsável: equipe de plataforma</span>
		</div>
	</div>
}

templ activityPanel() {
	<ul class="catalog-activity"><li>Configuração atualizada às 14h32.</li><li>Backup concluído às 12h00.</li><li>Nova versão publicada às 09h15.</li></ul>
}

templ partialProjects(page, fullPage int) {
	<div class="catalog-stack">
		@projectTable(page, 5)
		@ui.Pagination(partialProjectPagination(page, fullPage))
		@ui.Link(ui.LinkProps{Href: partialProjectURL(4, fullPage), Partial: &ui.PartialProps{TargetID: "partial-projects", History: true}}) {
			Abrir página 4 sem recarregar
		}
	</div>
}

templ projectTable(page, total int) {
	@ui.Table(ui.TableProps{Caption: fmt.Sprintf("Projetos da equipe · página %d de %d", page, total)}) {
		@ui.TableHead(ui.BaseProps{}) {
			@ui.TableRow(ui.BaseProps{}) {
				@ui.TableHeader(ui.TableCellProps{}) {
					Projeto 
				}
				@ui.TableHeader(ui.TableCellProps{}) {
					Ambiente 
				}
				@ui.TableHeader(ui.TableCellProps{}) {
					Estado 
				}
				@ui.TableHeader(ui.TableCellProps{Numeric: true}) {
					Membros 
				}
			}
		}
		@ui.TableBody(ui.BaseProps{}) {
			for i := range 4 {
				@ui.TableRow(ui.BaseProps{}) {
					@ui.TableCell(ui.TableCellProps{}) {
						{ []string{"Portal do cliente", "API de pagamentos", "Central de suporte", "Painel de operações"}[i] }<span class="catalog-project-id">{ fmt.Sprintf("PRJ-%04d", (page-1)*4+i+1) }</span>
					}
					@ui.TableCell(ui.TableCellProps{}) {
						{ []string{"Produção", "Produção", "Desenvolvimento", "Produção"}[i] }
					}
					@ui.TableCell(ui.TableCellProps{}) {
						@ui.Badge(ui.BadgeProps{Tone: ui.ToneSuccess}) {
							Ativo 
						}
					}
					@ui.TableCell(ui.TableCellProps{Numeric: true}) {
						{ strconv.Itoa((page-1)*4+i+2) }
					}
				}
			}
		}
	}
}
